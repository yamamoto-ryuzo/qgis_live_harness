{
  "name": "qgis-webengine-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:live": "cross-env QGIS_LIVE=1 playwright test tests/e2e/qgis-live.spec.ts",
    "test:unit": "python -m pytest tests/unit -v",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-plugin.ps1",
    "verify:qgis": "powershell -ExecutionPolicy Bypass -File scripts/verify-in-qgis.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^7.0.3"
  }
}
