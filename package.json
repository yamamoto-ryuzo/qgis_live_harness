{
  "name": "qgis_live_harness",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "test:live": "node scripts/qgis-live-check.mjs",
    "live:ensure": "node scripts/qgis-session.mjs ensure",
    "live:reload": "node scripts/qgis-session.mjs reload",
    "live:devreload": "node scripts/qgis-session.mjs devreload",
    "live:watch": "node scripts/live-watch.mjs",
    "mcp:qgis": "node scripts/qgis-mcp.mjs",
    "test:unit": "python -m pytest tests/unit -v",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-plugin.ps1",
    "deploy:status": "powershell -ExecutionPolicy Bypass -File scripts/deploy-plugin.ps1 -Status",
    "verify:qgis": "powershell -ExecutionPolicy Bypass -File scripts/verify-in-qgis.ps1",
    "deploy:use": "powershell -ExecutionPolicy Bypass -File scripts/deploy-plugin.ps1 -Use",
    "deploy:copy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-plugin.ps1 -Use",
    "deploy:install": "powershell -ExecutionPolicy Bypass -File scripts/deploy-plugin.ps1 -Install",
    "upstream": "powershell -ExecutionPolicy Bypass -File scripts/upstream-git.ps1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1"
  }
}
